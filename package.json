{
  "name": "otgolosok",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "node scripts/build-walk-catalog.mjs && next build && node scripts/build-content-security-policy.mjs && node scripts/build-service-worker.mjs",
    "start": "serve out",
    "lint": "eslint && stylelint \"src/**/*.css\" && prettier --check \"src/**/*.css\"",
    "format:css": "prettier --write \"src/**/*.css\" && stylelint --fix \"src/**/*.css\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.backend.json",
    "test": "vitest run && node --test backend/*.test.mjs",
    "test:py": "uv run ruff check . && uv run pyright && uv run pytest -q",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:py && pnpm build",
    "generator:dev": "STATIC_DIR=out node backend/server.mjs",
    "auth:set-editor": "node scripts/set-editor.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@softmg/airouter-logs": "file:vendor/softmg-airouter-logs-0.1.0.tgz",
    "better-auth": "1.7.5",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "maplibre-gl": "5.24.0",
    "next": "16.3.4",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "8.11.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "24.10.0",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "serve": "14.2.6",
    "stylelint": "^17.15.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.24.0"
}
