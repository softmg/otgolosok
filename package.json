{
  "name": "otgolosok",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "node scripts/build-walk-catalog.mjs && node scripts/build-map.mjs && next build && node scripts/build-content-security-policy.mjs && node scripts/build-service-worker.mjs",
    "start": "pnpm dlx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test backend/*.test.mjs",
    "generator:dev": "STATIC_DIR=out node backend/server.mjs",
    "auth:set-editor": "node scripts/set-editor.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@softmg/airouter-logs": "file:vendor/softmg-airouter-logs-0.1.0.tgz",
    "better-auth": "1.7.5",
    "leaflet": "1.9.4",
    "next": "16.3.4",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.1.1",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.24.0"
}
