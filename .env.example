# Optional: docker compose works without a .env file.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Must match the browser origin exactly (scheme, hostname and port; no path).
APP_ORIGIN=http://localhost:8080
USER_DAILY_GENERATION_LIMIT=6

# Runtime backend credentials only. Leave blank to disable AI generation/admin.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ADMIN_TOKEN=
# Enable only while migrating old scripts that still send ADMIN_TOKEN.
ALLOW_LEGACY_ADMIN_TOKEN=false
# Authentication (backend only). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
STORY_MODEL=codex/gpt-5.6-sol-medium
WRITER_MODEL=codex/gpt-5.6-sol-low
CONTENT_AUTO_APPROVE=false
CONTENT_WORKER_CONCURRENCY=1
# Optional Yandex SpeechKit service-account API key (backend only).
YANDEX_TTS_API_KEY=
YANDEX_TTS_VOICE=marina
MAX_DAILY_JOBS=6
# External local TTS workers. Generate two independent random secrets (32+ bytes).
WORKER_API_TOKEN=
# Required (32+ chars) in production when LOCAL_TTS_TRANSPORT=worker.
WORKER_LEASE_SECRET=
# Immutable external TTS profile metadata returned with each claim.
LOCAL_TTS_ENGINE=silero
LOCAL_TTS_TRANSPORT=worker
TTS_API_URL=
TTS_API_TOKEN=
SILERO_MODEL_SHA256=50081637b602126ee06cb3bc8a744d25651d2da149ee8864b9a379bfdd934437
SILERO_SPEAKER=baya
F5_MODEL_SHA256=
F5_REFERENCE_ID=
F5_CONFIG_SHA256=
F5_REFERENCE_SHA256=
F5_MINIMUM_PUBLICATION_DURATION_SEC=30

# Server-side structured logs sent to Airouter. Leave the token blank to disable.
AIROUTER_LOGS_ENDPOINT=https://airouter.softmg.tech
AIROUTER_LOGS_TOKEN=

VALHALLA_TILE_URL=https://download.bbbike.org/osm/bbbike/Moscow/Moscow.osm.pbf
VALHALLA_THREADS=2

# Automatic stops use the bundled Moscow OSM catalog by default.
# Optional external discovery: set WALK_DISCOVERY_SOURCE=overpass and configure
# WALK_OVERPASS_URL in the backend runtime environment.
